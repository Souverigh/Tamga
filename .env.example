# Скопируйте в .env для локальной разработки (vercel dev подхватит автоматически).
# В проде задайте эти переменные в Vercel → Project → Settings → Environment Variables.

# Ключ Google AI Studio для Gemini. Никогда не коммитьте настоящий ключ в git.
GEMINI_API_KEY=

# Ключи для публичного API (/api/v1/recognize), через запятую, без пробелов.
# Пример: TAMGA_API_KEYS=1c-integration-abc123,partner-xyz789
# Пока без учёта пользователей/лимитов — просто список валидных ключей.
# Сгенерировать ключ можно так: openssl rand -hex 24
TAMGA_API_KEYS=

# Конфиги клиентских пилотов (кастомные поля/типы документов/форматирование/
# white-label фасад — см. lib/customFieldsLookup.js), таблица tamga_api_key_fields
# в Supabase-проекте на havo-bishkek — общая база с проектом Havo, таблица
# с префиксом tamga_ во избежание путаницы.
# Не обязательны: если не заданы, кастомизация просто выключена, поведение
# по умолчанию (стандартный набор полей на тип документа) не меняется.
# Service role key — секретный, храните только на сервере, никогда не в браузере.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Секрет для входа в админку клиентов (/admin, см. lib/adminAuth.js) — один
# пароль для единственного администратора (Ethan), не список ключей.
# Сгенерировать: openssl rand -hex 24. Без этой переменной /api/admin/*
# и /admin отказывают всем запросам (fail-closed — это пишущий доступ
# к Supabase, в отличие от остальной кастомизации, которая fail-open).
TAMGA_ADMIN_SECRET=

# Дневной лимит страниц для анонимного бесплатного сайта (без ?client=slug) —
# см. lib/anonymousUsage.js, миграция tamga_anonymous_usage. Считается по хешу
# IP посетителя (сам IP не хранится). Не обязателен — по умолчанию 20 страниц/день.
# Требует SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY выше — без них лимит не
# применяется вовсе (fail-open, как и остальная инфраструктура учёта).
TAMGA_FREE_DAILY_PAGE_LIMIT=
